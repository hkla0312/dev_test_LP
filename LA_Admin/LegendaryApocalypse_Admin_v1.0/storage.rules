rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/admin/$(request.auth.uid))
      );
    }
    match /events/{eventId}/{fileName} { allow read: if isAdmin(); allow create, update: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'); allow delete: if isAdmin(); }
    match /artists/{artistId}/{fileName} { allow read: if isAdmin(); allow create, update: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'); allow delete: if isAdmin(); }
    match /site-settings/{fileName} { allow read: if true; allow create, update: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'); allow delete: if isAdmin(); }
  }
}
